{
  "Swagger": {
    "DocumentTitle": "Documentación API - Local",
    "Title": "API Manager Template - Local",
    "Name": "api-template-local",
    "DefinitionName": "API Manager Template Local",
    "Url": "/swagger/api-template-local/swagger.json",
    "SecurityName": "Bearer",
    "DescriptionToken": "JWT Authorization header using Bearer token",
    "HeaderName": "Authorization",
    "Scheme": "bearer",
    "BearerFormat": "JWT",
    "RoutePrefix": "swagger"
  }, 
  "MongoDB": {
    "ConnectionString": "mongodb://{USER}:{PASS}@{HOST}:{PORT}/?authSource=admin",
    "DatabaseName": "billing_db"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "{SMTP_USERNAME}",
    "Password": "{SMTP_PASSWORD}",
    "From": "{SMTP_FROM}",
    "FromName": "Sistema de Facturación"
  }
}
