{
  "Swagger": {
    "DocumentTitle": "Documentación API - Production",
    "Title": "API Manager Template - Production",
    "Name": "api-template-prod",
    "DefinitionName": "API Manager Template Production",
    "Url": "/swagger/api-template-prod/swagger.json",
    "SecurityName": "Bearer",
    "DescriptionToken": "JWT Authorization header using Bearer token",
    "HeaderName": "Authorization",
    "Scheme": "bearer",
    "BearerFormat": "JWT",
    "RoutePrefix": "swagger"
  },
  "MongoDB": {
    "ConnectionString": "mongodb://{HOST}:{PORT}",
    "DatabaseName": "{MONGO_DB_NAME}"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "EnableSsl": "true",
    "Username": "{SMTP_USERNAME}",
    "Password": "{SMTP_PASSWORD}",
    "From": "{SMTP_FROM}",
    "FromName": "Sistema de Facturación"
  }
}